# ---- Required ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SANDBOX_TOKEN=change-me-another-random-string
POSTGRES_PASSWORD=aria

# ---- LLM providers: configure at least one ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local models via Ollama (run `ollama serve` on your machine):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Which entry in backend/models.json to use by default, and for cheap background work
DEFAULT_MODEL_ID=claude-sonnet
UTILITY_MODEL_ID=claude-haiku

# ---- Embeddings for semantic memory & document search (optional; keyword search is used otherwise) ----
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# must match the model; set BEFORE first `docker compose up`
# EMBEDDING_DIM=1536

# ---- Web research (optional; one of these enables the web_search tool and Deep research) ----
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- Coding workspace (optional tuning) ----
# Tool rounds the AI may take per coding request, and how long an approval request waits for you
# WORKSPACE_MAX_AGENT_STEPS=40
# WORKSPACE_APPROVAL_TIMEOUT_MIN=15
# WORKSPACE_IMPORT_MAX_MB=50

# ---- Deployment ----
# Port Aria is served on (http://localhost:ARIA_PORT). Change it if 3000 is already used on your machine.
ARIA_PORT=3000
# true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ALLOW_SIGNUP=true

# ---- Autonomous agent action tools (each is enabled only when configured; all require your approval) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=you@example.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Set to false to disable the generic HTTP API tool
# ENABLE_HTTP_TOOL=true
